### Global:
GLOBAL_ARCHS_TO_BUILD=arm64-v8a
# GLOBAL_NORMALIZE_PATCH_NAMES=True
# GLOBAL_CLI_ARGSF=revanced-cli
# GLOBAL_CLI_DL=https://github.com/revanced/revanced-cli/releases/latest
# GLOBAL_PATCHES_DL=https://api.revanced.app/v5/patches.rvp
PATCH_APPS=pinterest,tiktok,proton_vpn,nokoprint
# EXTRA_FILES=
# EXISTING_DOWNLOADED_APKS=
REPACK_SPLIT_APKS=True

### Pinterest:
# PINTEREST_VERSION=latest_supported
# PINTEREST_OLD_KEY=True
# PINTEREST_KEYSTORE_FILE_NAME=revanced.keystore
# PINTEREST_ARCHS_TO_BUILD=arm64-v8a
PINTEREST_CLI_ARGSF=morphe-cli
PINTEREST_CLI_DL=https://github.com/MorpheApp/morphe-cli/releases/latest
PINTEREST_PATCHES_DL=https://github.com/SouBryan/pinterest-morphed/releases/latest
PINTEREST_PACKAGE_NAME=com.pinterest
PINTEREST_DL_SOURCE=https://www.apkmirror.com/apk/pinterest/pinterest-one-destination-for-a-world-of-inspiration/
# PINTEREST_NORMALIZE_PATCH_NAMES=True
# PINTEREST_INCLUDE_PATCH=
# PINTEREST_EXCLUDE_PATCH=

### TikTok:
# TIKTOK_VERSION=latest_supported
# TIKTOK_OLD_KEY=True
# TIKTOK_KEYSTORE_FILE_NAME=revanced.keystore
# TIKTOK_ARCHS_TO_BUILD=arm64-v8a
TIKTOK_CLI_ARGSF=morphe-cli
TIKTOK_CLI_DL=https://github.com/MorpheApp/morphe-cli/releases/latest
TIKTOK_PATCHES_DL=https://github.com/icysymmetra/tiktok-patches-for-morphe/releases/latest
TIKTOK_PACKAGE_NAME=com.zhiliaoapp.musically
TIKTOK_DL_SOURCE=https://www.apkmirror.com/apk/tiktok-pte-ltd/tik-tok-including-musical-ly/
# TIKTOK_NORMALIZE_PATCH_NAMES=True
# TIKTOK_INCLUDE_PATCH=
# TIKTOK_EXCLUDE_PATCH=

### Proton VPN:
PROTON_VPN_VERSION=latest
# PROTON_VPN_OLD_KEY=True
# PROTON_VPN_KEYSTORE_FILE_NAME=revanced.keystore
# PROTON_VPN_ARCHS_TO_BUILD=arm64-v8a
PROTON_VPN_CLI_ARGSF=morphe-cli
PROTON_VPN_CLI_DL=https://github.com/MorpheApp/morphe-cli/releases/latest
PROTON_VPN_PATCHES_DL=https://github.com/rushiranpise/morphe-patches/releases/latest
PROTON_VPN_PACKAGE_NAME=ch.protonvpn.android
PROTON_VPN_DL_SOURCE=apkeep
# PROTON_VPN_NORMALIZE_PATCH_NAMES=True
# PROTON_VPN_INCLUDE_PATCH=
# PROTON_VPN_EXCLUDE_PATCH=

### NokoPrint:
NOKOPRINT_VERSION=latest
# NOKOPRINT_OLD_KEY=True
# NOKOPRINT_KEYSTORE_FILE_NAME=revanced.keystore
# NOKOPRINT_ARCHS_TO_BUILD=arm64-v8a
NOKOPRINT_CLI_ARGSF=morphe-cli
NOKOPRINT_CLI_DL=https://github.com/MorpheApp/morphe-cli/releases/latest
NOKOPRINT_PATCHES_DL=https://github.com/jkennethcarino/adobo/releases/latest
NOKOPRINT_PACKAGE_NAME=com.nokoprint
NOKOPRINT_DL_SOURCE=apkeep
# NOKOPRINT_NORMALIZE_PATCH_NAMES=True
NOKOPRINT_INCLUDE_PATCH=disable-mobile-ads,block-ads-trackers-and-analytics,deactivate-firebase-analytics,deactivate-firebase-performance-monitoring,spoof-advertising-id
# NOKOPRINT_EXCLUDE_PATCH=
NOKOPRINT_OPTIONS_RAW="
Block ads, trackers, and analytics:
  hosts: ./apks/hosts.txt
  redirectionIp: 0.0.0.0
  isWildcard: true
"
